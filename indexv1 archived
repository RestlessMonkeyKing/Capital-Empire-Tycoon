function switchTab(name) {
  document.querySelectorAll('.tab').forEach(t => t.classList.toggle('active', t.dataset.tab === name));
  document.getElementById('tab-shop').style.display = name === 'shop' ? '' : 'none';
  document.getElementById('tab-inv').style.display = name === 'inv' ? '' : 'none';
  document.getElementById('tab-history').style.display = name === 'history' ? '' : 'none';
}
function openModal(id) { document.getElementById(id).classList.add('show'); }
function closeModal(id) { document.getElementById(id).classList.remove('show'); }

// ===================== GAME LOOP =====================
function gameLoop() {
  requestAnimationFrame(gameLoop);
  try {
    const now = Date.now(); const dt = (now - lastFrame) / 1000; lastFrame = now;
  const inc = getIncome() * dt;
  if (inc > 0) { game.money += inc; game.totalEarned += inc; }
  if (game.autoTapper > 0) {
    const autoEarn = game.clickPower * game.prestige.multiplier * (1 + game.discovered.length * 0.02) * game.autoTapper * dt;
    game.money += autoEarn; game.totalEarned += autoEarn;
  }
  if (now - game.lastAI > 1000) { updateAI((now - game.lastAI) / 1000); game.lastAI = now; }
  if (now - (game.lastBoostCheck || 0) > 5000) { maybeTriggerBoost(); game.lastBoostCheck = now; }
  updateBoostIndicator(); updateHUD();
  uiCounter++;
  if (uiCounter % 30 === 0) { renderShop(); renderClicker(); renderExpand(); renderDaily(); }
  if (uiCounter % 60 === 0) renderHistory();
  if (game.settings.autoSave && now - game.lastSave > 15000) { save(); game.lastSave = now; }
  if (now - (game.lastAchCheck || 0) > 1000) { checkAchievements(); game.lastAchCheck = now; }
  } catch (e) { console.error('Game loop error:', e); }
}

