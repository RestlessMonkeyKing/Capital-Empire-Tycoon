function playTone(freq, dur, type = 'sine', vol = 0.06, delay = 0) {
  if (!game.settings.sound) return;
  try {
    const ctx = getAudio(); const t = ctx.currentTime + delay;
    const osc = ctx.createOscillator(); const gain = ctx.createGain();
    osc.type = type; osc.frequency.setValueAtTime(freq, t);
    gain.gain.setValueAtTime(0, t); gain.gain.linearRampToValueAtTime(vol, t + 0.01); gain.gain.exponentialRampToValueAtTime(0.0001, t + dur);
    osc.connect(gain); gain.connect(ctx.destination); osc.start(t); osc.stop(t + dur + 0.05);
  } catch (e) {}
}
