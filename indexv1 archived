  startBtn.onclick = () => startGame(currentGame);
  overlay.classList.remove('hide');
  document.getElementById('game-score').style.display = 'none';
  sndArcade();
  updateHUD(); save();
}

function initFlappy(ctx, canvas) {
  const W = 440, H = 360;
  let bird = { x: 100, y: 180, w: 28, h: 28, vel: 0, rot: 0 };
  let pipes = [];
  let score = 0;
  let frame = 0;
  const GRAVITY = 0.4;
  const FLAP = -7;
  const PIPE_SPEED = 2.5;
  const GAP = 130;
  
  const flap = () => { bird.vel = FLAP; };
  canvas.onclick = flap;
  document.onkeydown = (e) => { if(e.code === 'Space') { e.preventDefault(); flap(); } };
  
  document.getElementById('game-overlay').classList.add('hide');
  document.getElementById('game-score').style.display = 'block';
  document.getElementById('game-score').textContent = '0';

  function flappyLoop() {
    frame++;
    ctx.fillStyle = '#0d1322'; ctx.fillRect(0, 0, W, H);
    
    // Clouds
    ctx.fillStyle = 'rgba(255,255,255,0.05)';
    for(let i=0; i<4; i++) {
      let x = (frame * 0.5 + i * 120) % (W + 80) - 40;
      ctx.beginPath(); ctx.arc(x, 60 + i*30, 25, 0, Math.PI*2); ctx.fill();
    }
    
    bird.vel += GRAVITY;
    bird.y += bird.vel;
    bird.rot = Math.max(-0.4, Math.min(1.2, bird.vel / 10));
    
    if (frame % 90 === 0) {
      let gapY = 50 + Math.random() * (H - 100 - GAP);
      pipes.push({ x: W, gapY: gapY, passed: false });
    }
    
    ctx.fillStyle = '#10d981';
    pipes.forEach(p => {
      p.x -= PIPE_SPEED;
      ctx.fillRect(p.x, 0, 50, p.gapY);
      ctx.fillRect(p.x, p.gapY + GAP, 50, H - (p.gapY + GAP));
      ctx.fillStyle = '#0aaf68';
      ctx.fillRect(p.x - 3, p.gapY - 20, 56, 20);
      ctx.fillRect(p.x - 3, p.gapY + GAP, 56, 20);
      ctx.fillStyle = '#10d981';
      
      if (bird.x + bird.w > p.x && bird.x < p.x + 50) {
        if (bird.y < p.gapY || bird.y + bird.h > p.gapY + GAP) {
          endGame(score);
        }
      }
      if (!p.passed && p.x + 50 < bird.x) {
        p.passed = true; score++; sndClick();
        document.getElementById('game-score').textContent = score;
      }
    });
    pipes = pipes.filter(p => p.x > -60);
    
    ctx.save();
    ctx.translate(bird.x + bird.w/2, bird.y + bird.h/2);
    ctx.rotate(bird.rot);
    ctx.fillStyle = '#f5c451';
    ctx.fillRect(-bird.w/2, -bird.h/2, bird.w, bird.h);
    ctx.strokeStyle = '#d99a2b'; ctx.lineWidth = 2;
    ctx.strokeRect(-bird.w/2, -bird.h/2, bird.w, bird.h);
    ctx.fillStyle = '#1a1408'; ctx.font = 'bold 18px Outfit'; ctx.textAlign = 'center';
    ctx.fillText('$', 0, 5);
    ctx.restore();
    
    if (bird.y > H - 10 || bird.y < 0) endGame(score);
    
    if (currentGame === 'flappy') gameRAF = requestAnimationFrame(flappyLoop);
  }
  loop();
}

function initSnake(ctx, canvas) {
  const W = 440, H = 360, CELL = 20;
  const COLS = W / CELL, ROWS = H / CELL;
  let snake = [{x: 5, y: 9}, {x: 4, y: 9}, {x: 3, y: 9}];
  let dir = {x: 1, y: 0};
  let nextDir = {x: 1, y: 0};
  let food = {x: 10, y: 9};
  let score = 0;
  
  document.onkeydown = (e) => {
    if (e.key === 'ArrowUp' && nextDir.y === 0) nextDir = {x: 0, y: -1};
    if (e.key === 'ArrowDown' && nextDir.y === 0) nextDir = {x: 0, y: 1};
    if (e.key === 'ArrowLeft' && nextDir.x === 0) nextDir = {x: -1, y: 0};
    if (e.key === 'ArrowRight' && nextDir.x === 0) nextDir = {x: 1, y: 0};
  };
  
  document.getElementById('game-overlay').classList.add('hide');
  document.getElementById('game-score').style.display = 'block';
  document.getElementById('game-score').textContent = '0';

  function update() {
    dir = nextDir;
    let head = {x: snake[0].x + dir.x, y: snake[0].y + dir.y};
    
    if (head.x < 0 || head.x >= COLS || head.y < 0 || head.y >= ROWS) return endGame(score);
    if (snake.some(s => s.x === head.x && s.y === head.y)) return endGame(score);
    
    snake.unshift(head);
    
    if (head.x === food.x && head.y === food.y) {
      score++; sndClick();
      document.getElementById('game-score').textContent = score;
      let newFood;
      do {
        newFood = {x: Math.floor(Math.random() * COLS), y: Math.floor(Math.random() * ROWS)};
      } while (snake.some(s => s.x === newFood.x && s.y === newFood.y));
      food = newFood;
    } else {
      snake.pop();
    }
  }

  function draw() {
    ctx.fillStyle = '#0d1322'; ctx.fillRect(0, 0, W, H);
    ctx.strokeStyle = 'rgba(255,255,255,0.03)'; ctx.lineWidth = 1;
    for(let i=0; i<=COLS; i++) { ctx.beginPath(); ctx.moveTo(i*CELL, 0); ctx.lineTo(i*CELL, H); ctx.stroke(); }
    for(let i=0; i<=ROWS; i++) { ctx.beginPath(); ctx.moveTo(0, i*CELL); ctx.lineTo(W, i*CELL); ctx.stroke(); }
    
    ctx.fillStyle = '#10d981';
    ctx.beginPath(); ctx.arc(food.x*CELL + CELL/2, food.y*CELL + CELL/2, CELL/2 - 2, 0, Math.PI*2); ctx.fill();
    ctx.fillStyle = '#fff'; ctx.font = 'bold 12px Outfit'; ctx.textAlign = 'center';
    ctx.fillText('$', food.x*CELL + CELL/2, food.y*CELL + CELL/2 + 4);
    
    snake.forEach((s, i) => {
      ctx.fillStyle = i === 0 ? '#f5c451' : '#d99a2b';
      ctx.fillRect(s.x*CELL + 1, s.y*CELL + 1, CELL - 2, CELL - 2);
      if (i === 0) {
        ctx.fillStyle = '#1a1408'; ctx.font = 'bold 12px Outfit';
        ctx.fillText('$', s.x*CELL + CELL/2, s.y*CELL + CELL/2 + 4);
      }
    });
  }

  gameInterval = setInterval(() => {
    if (currentGame === 'snake') { update(); draw(); }
  }, 110);
}

function initCatcher(ctx, canvas) {
  const W = 440, H = 360;
  let player = { x: W/2, w: 60, h: 20 };
  let objs = [];
  let score = 0;
  let frame = 0;
  let speed = 2;
  
  canvas.onmousemove = (e) => {
    const rect = canvas.getBoundingClientRect();
    player.x = (e.clientX - rect.left) * (W / rect.width);
  };
  canvas.ontouchmove = (e) => {
    e.preventDefault();
    const rect = canvas.getBoundingClientRect();
    player.x = (e.touches[0].clientX - rect.left) * (W / rect.width);
  };
  
  document.getElementById('game-overlay').classList.add('hide');
  document.getElementById('game-score').style.display = 'block';
  document.getElementById('game-score').textContent = '0';

  function catcherLoop() {
    frame++;
    ctx.fillStyle = '#0d1322'; ctx.fillRect(0, 0, W, H);
    
    if (frame % 30 === 0) {
      let r = Math.random();
      let type = r > 0.85 ? 'bomb' : (r > 0.6 ? 'cash' : 'coin');
      objs.push({ x: Math.random() * (W - 40) + 20, y: -20, type: type, vel: speed + Math.random() * 1.5 });
    }
    if (frame % 300 === 0) speed += 0.5;
    
    ctx.fillStyle = '#38bdf8';
    ctx.fillRect(player.x - player.w/2, H - 30, player.w, player.h);
    ctx.fillStyle = '#fff'; ctx.font = 'bold 12px Outfit'; ctx.textAlign = 'center';
    ctx.fillText('BASKET', player.x, H - 17);
    
    objs.forEach(o => {
      o.y += o.vel;
      if (o.type === 'coin') {
        ctx.fillStyle = '#f5c451';
        ctx.beginPath(); ctx.arc(o.x, o.y, 10, 0, Math.PI*2); ctx.fill();
        ctx.fillStyle = '#1a1408'; ctx.font = 'bold 12px Outfit';
        ctx.fillText('$', o.x, o.y + 4);
      } else if (o.type === 'cash') {
        ctx.fillStyle = '#10d981';
        ctx.fillRect(o.x - 10, o.y - 6, 20, 12);
        ctx.fillStyle = '#fff'; ctx.font = 'bold 10px Outfit';
        ctx.fillText('$$', o.x, o.y + 3);
      } else {
        ctx.fillStyle = '#ef4458';
        ctx.beginPath(); ctx.arc(o.x, o.y, 10, 0, Math.PI*2); ctx.fill();
        ctx.fillStyle = '#fff'; ctx.font = 'bold 12px Outfit';
        ctx.fillText('X', o.x, o.y + 4);
      }
      
      if (o.y > H - 35 && o.y < H - 15 && Math.abs(o.x - player.x) < player.w/2 + 10) {
        if (o.type === 'bomb') return endGame(score);
        if (o.type === 'coin') score += 1;
        if (o.type === 'cash') score += 3;
        sndClick();
        document.getElementById('game-score').textContent = score;
        o.y = H + 100;
      }
    });
    objs = objs.filter(o => o.y < H + 50);
    
    if (currentGame === 'catcher') gameRAF = requestAnimationFrame(catcherLoop);
  }
  loop();
}

