function spawnFloatingSymbols() {
  const symbols = ['$', '€', '£', '¥', '₿'];
  for (let i = 0; i < 12; i++) {
    const s = document.createElement('div'); s.className = 'floating-symbol';
    s.textContent = symbols[Math.floor(Math.random() * symbols.length)];
    s.style.left = Math.random() * 100 + 'vw'; s.style.fontSize = (40 + Math.random() * 70) + 'px';
    s.style.animationDuration = (20 + Math.random() * 25) + 's'; s.style.animationDelay = -Math.random() * 30 + 's';
    document.body.appendChild(s);
  }
}

// ===================== AUTH SYSTEM =====================
let currentSession = null;

function hideLoadingScreen() {
  const ls = document.getElementById('loading-screen');
  if (!ls) return;
