  game.money -= cost; game.gridIndex++;
  const newSize = getGridSize(); while (game.grid.length < newSize * newSize) game.grid.push(null);
  sndUpgrade(); toast('District Expanded!', `Now ${newSize}×${newSize} with ${newSize*newSize} lots.`, 'fa-expand', '#10d981');
  renderGrid(); renderExpand(); updateHUD();
}
