}

async function doSignOut() {
  try { await supabaseClient.auth.signOut(); } catch (e) {}
  currentSession = null;
  supabaseReady = false;
  game = createNewGame();
  renderAll();
  toast('Signed Out', 'Your session has ended.', 'fa-right-from-bracket', '#9ca3af');
  showAuthModal('login');
}

async function loadGameFromCloud() {
  try {
    const loaded = await load();
    if (loaded) {
      setTimeout(() => toast('Welcome Back!', `Balance: ${money(game.money)} · ${money(getIncome())}/sec`, 'fa-arrow-right-to-bracket', '#10d981'), 500);
    } else {
      setTimeout(() => toast('Welcome, Tycoon!', 'Click the gold button to earn your first dollars.', 'fa-hand-pointer', '#f5c451'), 500);
    }
  } catch (e) {
    console.error('Cloud load failed:', e);
    setTimeout(() => toast('Offline Mode', 'Playing with local progress.', 'fa-wifi', '#ef4458'), 500);
  }
}
// ===================== INIT =====================
async function init() {
  const loadingScreen = document.getElementById('loading-screen');
  const loadingError = document.getElementById('loading-error');
  const skipBtn = document.getElementById('loading-skip');

  // ALWAYS hide loading screen after 2 seconds — no exceptions
  setTimeout(() => {
    hideLoadingScreen();
    if (skipBtn) skipBtn.style.display = 'none';
  }, 2000);

  // Show skip button after 1 second
  setTimeout(() => {
    if (skipBtn) {
      skipBtn.style.display = 'inline-block';
      skipBtn.onclick = () => {
        hideLoadingScreen();
        skipBtn.style.display = 'none';
        toast('Offline Mode', 'Skipped connection. Playing locally.', 'fa-forward', '#9ca3af');
      };
    }
  }, 1000);

  // Initialize Supabase client safely
  try {
    if (typeof supabase !== 'undefined' && supabase.createClient) {
      supabaseClient = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
    }
  } catch (e) {
    console.warn('Supabase init failed:', e);
  }

  // If Supabase loaded, try to restore session
  if (supabaseClient) {
    try {
      const { data: sessionData, error: sessionError } = await supabaseClient.auth.getSession();
      if (sessionError) console.warn('Session error:', sessionError);

      if (sessionData?.session) {
        currentSession = sessionData.session;
        supabaseReady = true;
        await loadGameFromCloud();
      } else {
        // No session — show auth modal after loading screen fades
        setTimeout(() => showAuthModal('login'), 2200);
      }

      // Listen for auth state changes
      supabaseClient.auth.onAuthStateChange((event, session) => {
        currentSession = session;
        supabaseReady = !!session;
        if (event === 'SIGNED_IN') toast('Connected', 'Cloud sync is now active.', 'fa-cloud', '#10d981');
        else if (event === 'SIGNED_OUT') supabaseReady = false;
      });
    } catch (e) {
      console.error('Auth init error:', e);
      if (loadingError) {
        loadingError.textContent = 'Connection issue. You can play offline or try signing in later from Settings.';
        loadingError.style.display = 'block';
      }
      setTimeout(() => showAuthModal('login'), 2200);
    }
  } else {
    if (loadingError) {
      loadingError.textContent = 'Supabase library failed to load. Check your internet connection.';
      loadingError.style.display = 'block';
    }
  }

  renderAll(); spawnFloatingSymbols();
  setupEventListeners();
  lastFrame = Date.now(); requestAnimationFrame(gameLoop);
}

function setupEventListeners() {
  document.addEventListener('click', async () => {
    if (audioCtx && audioCtx.state === 'suspended') await audioCtx.resume();
  }, { once: true });

  document.getElementById('click-btn').addEventListener('click', doClick);
  document.getElementById('upgrade-click').addEventListener('click', upgradeClick);
  document.getElementById('upgrade-auto').addEventListener('click', upgradeAuto);
  document.getElementById('expand-btn').addEventListener('click', expandGrid);
  document.getElementById('cancel-placing').addEventListener('click', cancelPlacing);
  document.getElementById('crate-place').addEventListener('click', placeFromCrate);
  document.getElementById('daily-bonus-btn').addEventListener('click', claimDaily);

  document.getElementById('crate-list').addEventListener('click', (e) => {
    const crateEl = e.target.closest('.crate');
    if (crateEl && !crateEl.classList.contains('disabled')) buyCrate(crateEl.dataset.crate);
  });

  document.getElementById('inv-list').addEventListener('click', (e) => {
    const itemEl = e.target.closest('.inv-item');
    if (itemEl) startPlacing(itemEl.dataset.id);
  });

  document.querySelectorAll('.tab').forEach(t => t.addEventListener('click', () => switchTab(t.dataset.tab)));

  document.getElementById('btn-arcade').addEventListener('click', openArcade);
  document.getElementById('btn-collection').addEventListener('click', () => { renderCollection(); openModal('modal-collection'); });
  document.getElementById('btn-leaderboard').addEventListener('click', () => { renderLeaderboard(); openModal('modal-leaderboard'); });
  document.getElementById('btn-achievements').addEventListener('click', () => { renderAchievements(); openModal('modal-achievements'); });
  document.getElementById('btn-settings').addEventListener('click', () => { renderSettings(); openModal('modal-settings'); });

  document.querySelectorAll('[data-close]').forEach(b => { 
    b.addEventListener('click', e => {
      const modal = e.target.closest('.modal-bg');
      modal.classList.remove('show');
      if (modal.id === 'modal-game') { stopGameLoop(); currentGame = null; document.onkeydown = null; }
      crateAnimating = false;
    });
  });

  document.querySelectorAll('.modal-bg').forEach(bg => { 
    bg.addEventListener('click', e => { 
      if (e.target === bg) {
        bg.classList.remove('show');
        if (bg.id === 'modal-game') { stopGameLoop(); currentGame = null; document.onkeydown = null; }
      }
    });
  });

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') { 
      document.querySelectorAll('.modal-bg.show').forEach(m => {
        m.classList.remove('show');
        if (m.id === 'modal-game') { stopGameLoop(); currentGame = null; document.onkeydown = null; }
      });
      if (placingId) cancelPlacing(); 
    }
    if (e.key === ' ' && !e.target.matches('input,select,textarea') && !document.getElementById('modal-game').classList.contains('show')) { 
      e.preventDefault(); document.getElementById('click-btn').click(); 
    }
  });

  const tip = document.getElementById('help-tip');
  document.addEventListener('mouseover', e => {
    const target = e.target.closest('[data-tip]');
    if (target) {
      const [name, desc] = target.dataset.tip.split('|');
      tip.innerHTML = `<b>${name}</b>${desc}`;
      const r = target.getBoundingClientRect();
      tip.style.left = r.left + 'px'; tip.style.top = (r.bottom + 6) + 'px'; tip.classList.add('show');
    }
  });
  document.addEventListener('mouseout', e => { if (e.target.closest('[data-tip]')) tip.classList.remove('show'); });

  window.addEventListener('beforeunload', () => { if (supabaseReady) save(); });
  window.addEventListener('pagehide', () => { if (supabaseReady) save(); });
  document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'hidden' && supabaseReady) save(); });

  window.redeemCode = redeemCode;
  window.startGame = startGame;
}
init();
