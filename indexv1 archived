function redeemCode() {
  const input = document.getElementById('promo-input');
  const code = input.value.toLowerCase().trim();
  if (!code) return;
  if (game.redeemedCodes.includes(code)) {
    toast("Already Redeemed", "You have already used this code.", "fa-circle-exclamation", "#ef4458");
    return;
  }
  let reward = 0, msg = "";
  if (code === "rohind") { reward = 1e9; msg = "You received $1,000,000,000!"; }
  
  if (reward > 0) {
    game.money += reward; game.totalEarned += reward;
    game.redeemedCodes.push(code);
    sndCode(); toast("Promo Redeemed!", msg, "fa-gift", "#10d981");
    confetti(window.innerWidth / 2, window.innerHeight / 3, '#10d981');
    input.value = "";
    updateHUD(); save();
  } else {
    toast("Invalid Code", "This promo code does not exist or is expired.", "fa-circle-xmark", "#ef4458");
    sndError();
  }
