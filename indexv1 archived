      <label class="auth-label">Email</label>
      <input type="email" class="auth-input" id="reg-email" placeholder="you@example.com" />
      <label class="auth-label">Password</label>
      <input type="password" class="auth-input" id="reg-password" placeholder="Min 6 characters" />
      <label class="auth-label">Confirm Password</label>
      <input type="password" class="auth-input" id="reg-confirm" placeholder="Repeat password" />
      <div class="auth-error" id="auth-reg-error"></div>
      <button class="auth-btn" id="auth-reg-btn"><i class="fas fa-user-plus"></i> Create Account</button>
    </div>
    <div class="auth-info">Guest accounts save to cloud anonymously. Registered accounts use email.</div>
  `;
  el.querySelectorAll('.auth-tab').forEach(t => {
    t.addEventListener('click', () => {
      const tab = t.dataset.authTab;
      el.querySelectorAll('.auth-tab').forEach(x => x.classList.toggle('active', x === t));
      el.querySelectorAll('.auth-form').forEach(x => x.classList.toggle('active', x.id === 'auth-' + tab));
    });
  });
  el.querySelector('#auth-login-btn')?.addEventListener('click', doSignIn);
  el.querySelector('#auth-reg-btn')?.addEventListener('click', doSignUp);
  el.querySelector('#auth-guest-btn')?.addEventListener('click', doGuestSignIn);
  el.querySelector('#auth-offline-btn')?.addEventListener('click', () => { closeModal('modal-auth'); toast('Offline Mode', 'Playing without cloud sync.', 'fa-wifi', '#ef4458'); });
  el.querySelectorAll('input').forEach(inp => {
    inp.addEventListener('keydown', e => {
      if (e.key === 'Enter') {
        const form = inp.closest('.auth-form');
        if (form?.id === 'auth-login') doSignIn();
        else if (form?.id === 'auth-register') doSignUp();
      }
    });
  });
  openModal('modal-auth');
}

async function doSignIn() {
  const email = document.getElementById('auth-email')?.value.trim();
  const password = document.getElementById('auth-password')?.value;
  const errEl = document.getElementById('auth-login-error');
  const btn = document.getElementById('auth-login-btn');
  if (!email || !password) { if (errEl) errEl.textContent = 'Please enter email and password.'; return; }
  btn.disabled = true; btn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Signing in...';
  try {
    const { data, error } = await supabaseClient.auth.signInWithPassword({ email, password });
    if (error) throw error;
    currentSession = data.session;
    supabaseReady = true;
    closeModal('modal-auth');
    await loadGameFromCloud();
    toast('Welcome back!', 'Signed in successfully.', 'fa-user-check', '#10d981');
  } catch (e) {
    if (errEl) errEl.textContent = e.message || 'Sign in failed.';
    btn.disabled = false; btn.innerHTML = '<i class="fas fa-right-to-bracket"></i> Sign In';
  }
}

async function doSignUp() {
  const email = document.getElementById('reg-email')?.value.trim();
  const password = document.getElementById('reg-password')?.value;
  const confirm = document.getElementById('reg-confirm')?.value;
  const errEl = document.getElementById('auth-reg-error');
  const btn = document.getElementById('auth-reg-btn');
  if (!email || !password) { if (errEl) errEl.textContent = 'Please fill in all fields.'; return; }
  if (password.length < 6) { if (errEl) errEl.textContent = 'Password must be at least 6 characters.'; return; }
  if (password !== confirm) { if (errEl) errEl.textContent = 'Passwords do not match.'; return; }
  btn.disabled = true; btn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Creating...';
  try {
    const { data, error } = await supabaseClient.auth.signUp({ email, password });
    if (error) throw error;
    currentSession = data.session;
    supabaseReady = true;
    closeModal('modal-auth');
    toast('Account Created!', 'Welcome to Capital Empire.', 'fa-user-plus', '#10d981');
    await loadGameFromCloud();
  } catch (e) {
    if (errEl) errEl.textContent = e.message || 'Registration failed.';
    btn.disabled = false; btn.innerHTML = '<i class="fas fa-user-plus"></i> Create Account';
  }
}

async function doGuestSignIn() {
  const btn = document.getElementById('auth-guest-btn');
  btn.disabled = true; btn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Starting...';
  try {
    const { data, error } = await supabaseClient.auth.signInAnonymously();
    if (error) throw error;
    currentSession = data.session;
    supabaseReady = true;
    closeModal('modal-auth');
    await loadGameFromCloud();
    toast('Guest Mode', 'Playing with cloud sync enabled.', 'fa-user-secret', '#f5c451');
  } catch (e) {
    supabaseReady = false;
    closeModal('modal-auth');
    toast('Offline Mode', 'Could not connect. Progress is local only.', 'fa-wifi', '#ef4458');
