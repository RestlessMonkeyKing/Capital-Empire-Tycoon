  if (!canClaimDaily()) return;
  if (Date.now() - game.daily.lastClaim > DAY_MS * 2) game.daily.streak = 0; // Reset streak if missed a day
  const reward = getNextDailyReward();
  game.money += reward; game.totalEarned += reward; game.daily.streak++; game.daily.lastClaim = Date.now(); game.stats.dailyClaimed++;
  sndDaily(); toast('Daily Bonus Claimed!', `Received ${money(reward)}. Streak: ${game.daily.streak} day${game.daily.streak !== 1 ? 's' : ''}.`, 'fa-gift', '#f5c451');
