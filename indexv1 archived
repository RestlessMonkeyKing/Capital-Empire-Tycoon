// ===================== SAVE / LOAD =====================
async function save() {
  if (!game.settings.autoSave || !supabaseReady) return;
  try {
    const saveData = JSON.parse(JSON.stringify(game));
    saveData.lastSave = Date.now();
    await supabaseClient.rpc('save_game', { p_game_data: saveData });
    game.lastSave = Date.now();
  } catch (e) { console.error("Cloud save failed", e); }
}

async function load() {
  try {
    const { data, error } = await supabaseClient.rpc('get_game');
    if (error || !data) { console.error('Load error:', error); return false; }
    const loaded = (typeof data === 'string') ? JSON.parse(data) : data;
    if (!loaded || typeof loaded !== 'object') return false;
    const def = createNewGame();
    game = Object.assign(def, loaded);
    game.settings = Object.assign(def.settings, loaded.settings || {});
    game.stats = Object.assign(def.stats, loaded.stats || {});
    game.boost = Object.assign(def.boost, loaded.boost || {});
    game.daily = Object.assign(def.daily, loaded.daily || {});
    game.prestige = Object.assign(def.prestige, loaded.prestige || {});
    game.arcade = Object.assign(def.arcade, loaded.arcade || {});
    if (!Array.isArray(game.pullHistory)) game.pullHistory = [];
    if (!Array.isArray(game.inventory)) game.inventory = [];
    if (!Array.isArray(game.discovered)) game.discovered = [];
    if (!Array.isArray(game.redeemedCodes)) game.redeemedCodes = [];
    if (!Array.isArray(game.ai)) game.ai = JSON.parse(JSON.stringify(AI_COMPETITORS));
    game.grid = game.grid.map(c => { if (c === null) return null; if (typeof c === 'string') return { id: c, level: 1 }; return c; });
    if (!game.playerName) game.playerName = 'Tycoon';
    const offline = Math.min((Date.now() - (loaded.lastSave || Date.now())) / 1000, 3600 * 8);
    const inc = getIncome() * offline;
    if (inc > 0) {
      game.money += inc; game.totalEarned += inc;
      if (offline > 30) setTimeout(() => toast('Welcome Back!', `Earned ${money(inc)} while away (${Math.floor(offline/60)}m).`, 'fa-clock', '#10d981'), 600);
    }
    const aiMul = Math.pow(1.0003, offline);
    game.ai.forEach(a => { a.money *= aiMul; a.income *= aiMul; });
    return true;
  } catch (e) { console.error("Load failed", e); return false; }
}

async function hardReset() {
  try { if (supabaseReady) await supabaseClient.rpc('delete_save'); } catch (e) { console.error('Reset error:', e); }
  game = createNewGame();
  renderAll();
  toast('Game Reset', 'Your empire has been wiped clean.', 'fa-trash', '#ef4458');
}
