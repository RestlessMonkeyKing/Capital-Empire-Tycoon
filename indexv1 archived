function rollCrate(crateId) {
  const crate = CRATES[crateId]; const r = Math.random(); let cum = 0; let rarity = 'common';
  for (const k of ['common', 'uncommon', 'rare', 'epic', 'legendary', 'mythic', 'cosmic']) {
    cum += crate.odds[k]; if (r <= cum) { rarity = k; break; }
  }
  const pool = Object.entries(BUILDINGS).filter(([_, b]) => b.rarity === rarity);
  const [buildingId] = pool[Math.floor(Math.random() * pool.length)];
  return { buildingId, rarity };
}
