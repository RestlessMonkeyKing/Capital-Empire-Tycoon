function endGame(score) {
  stopGameLoop();
  if (!currentGame) return;
  
  const overlay = document.getElementById('game-overlay');
  const oTitle = document.getElementById('game-overlay-title');
  const oDesc = document.getElementById('game-overlay-desc');
  const startBtn = document.getElementById('game-start-btn');
  
  let reward = 0;
  if (currentGame === 'flappy') reward = score * 1000 * game.prestige.multiplier;
  if (currentGame === 'snake') reward = score * 5000 * game.prestige.multiplier;
  if (currentGame === 'catcher') reward = score * 2000 * game.prestige.multiplier;
  
  if (score > game.arcade[currentGame]) {
    game.arcade[currentGame] = score;
    oTitle.textContent = "New High Score!";
  } else {
    oTitle.textContent = "Game Over";
  }
  
  game.money += reward; game.totalEarned += reward;
  oDesc.innerHTML = `Score: <b style="color:var(--gold)">${score}</b><br>Reward: <b style="color:var(--emerald)">${money(reward)}</b>`;
