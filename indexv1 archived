<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Capital Empire — Tycoon</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;500;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>
<style>
:root {
  --bg: #050810; --bg-2: #0a0f1c; --card: #111729; --card-2: #1a2138; --card-3: #232c48;
  --border: rgba(255,255,255,0.07); --border-2: rgba(255,255,255,0.12);
  --fg: #eef1f8; --fg-2: #c8cee0; --muted: #6b7494; --muted-2: #8a93b0;
  --gold: #f5c451; --gold-2: #d99a2b; --gold-3: #fff3c4;
  --emerald: #10d981; --emerald-2: #0aaf68; --crimson: #ef4458; --azure: #38bdf8;
  --r-common: #9ca3af; --r-uncommon: #4ade80; --r-rare: #38bdf8; --r-epic: #c084fc; --r-legendary: #fbbf24;
  --r-mythic: #f43f5e; --r-cosmic: #d946ef;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { height: 100%; }
body {
  font-family: 'Space Grotesk', system-ui, sans-serif;
  background: var(--bg); color: var(--fg); overflow: hidden; position: relative; -webkit-font-smoothing: antialiased;
}
body::before {
  content: ''; position: fixed; inset: 0; z-index: -2;
  background:
    radial-gradient(ellipse 70% 50% at 10% 0%, rgba(245,196,81,0.08), transparent 60%),
    radial-gradient(ellipse 60% 50% at 90% 100%, rgba(16,217,129,0.06), transparent 60%),
    radial-gradient(ellipse 50% 40% at 50% 50%, rgba(56,189,248,0.04), transparent 70%),
    linear-gradient(180deg, #050810 0%, #0a0f1c 100%);
}
body::after {
  content: ''; position: fixed; inset: 0; z-index: -1; pointer-events: none;
  background-image: linear-gradient(rgba(255,255,255,0.015) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.015) 1px, transparent 1px);
  background-size: 50px 50px;
  mask-image: radial-gradient(ellipse 80% 70% at 50% 30%, black 30%, transparent 80%);
}
.floating-symbol { position: fixed; font-family: 'Outfit', sans-serif; font-weight: 900; color: rgba(245,196,81,0.035); pointer-events: none; z-index: -1; animation: floatSym linear infinite; user-select: none; }
@keyframes floatSym { from { transform: translateY(110vh) rotate(0deg); } to { transform: translateY(-20vh) rotate(360deg); } }
::-webkit-scrollbar { width: 6px; height: 6px; } ::-webkit-scrollbar-track { background: transparent; } ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 3px; } ::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.2); }

.game { display: grid; grid-template-rows: auto 1fr; height: 100vh; max-width: 1600px; margin: 0 auto; padding: 12px; gap: 10px; }

.hud { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 20px; padding: 10px 20px; background: linear-gradient(180deg, rgba(17,23,41,0.9), rgba(17,23,41,0.7)); border: 1px solid var(--border); border-radius: 16px; backdrop-filter: blur(20px); position: relative; overflow: hidden; }
.hud::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent, rgba(245,196,81,0.4), transparent); }
.brand { display: flex; align-items: center; gap: 11px; }
.brand-mark { width: 40px; height: 40px; border-radius: 11px; background: linear-gradient(135deg, var(--gold-3), var(--gold), var(--gold-2)); display: grid; place-items: center; font-family: 'Outfit', sans-serif; font-weight: 900; color: #1a1408; font-size: 20px; box-shadow: 0 4px 20px rgba(245,196,81,0.3), inset 0 1px 0 rgba(255,255,255,0.3); }
.brand-text { font-family: 'Outfit', sans-serif; font-weight: 800; font-size: 16px; letter-spacing: -0.01em; line-height: 1; }
.brand-text span { color: var(--gold); }
.brand-text small { display: block; font-size: 9px; font-weight: 500; color: var(--muted); letter-spacing: 0.2em; text-transform: uppercase; margin-top: 3px; }
.hud-stats { display: flex; align-items: center; justify-content: center; gap: 28px; }
.stat { display: flex; flex-direction: column; align-items: center; gap: 1px; }
.stat-label { font-size: 9px; text-transform: uppercase; letter-spacing: 0.2em; color: var(--muted); font-weight: 700; }
.stat-value { font-family: 'Outfit', sans-serif; font-weight: 800; font-size: 22px; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; line-height: 1.1; }
.stat-money .stat-value { color: var(--gold); font-size: 26px; text-shadow: 0 0 25px rgba(245,196,81,0.25); }
.stat-income .stat-value { color: var(--emerald); } .stat-income .stat-value::before { content: '+'; opacity: 0.6; }
.stat-prestige .stat-value { color: var(--azure); }
.boost-indicator { display: none; align-items: center; gap: 6px; padding: 5px 12px; background: linear-gradient(90deg, rgba(245,196,81,0.15), rgba(245,196,81,0.05)); border: 1px solid rgba(245,196,81,0.4); border-radius: 20px; font-family: 'Outfit', sans-serif; font-weight: 800; font-size: 12px; color: var(--gold); animation: boostPulse 1s ease-in-out infinite; }
.boost-indicator.show { display: flex; }
@keyframes boostPulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(245,196,81,0.3); } 50% { box-shadow: 0 0 0 6px rgba(245,196,81,0); } }
.hud-actions { display: flex; gap: 7px; }
.icon-btn { width: 40px; height: 40px; border-radius: 11px; background: var(--card-2); border: 1px solid var(--border); color: var(--fg-2); cursor: pointer; display: grid; place-items: center; font-size: 14px; transition: all .2s; position: relative; }
.icon-btn:hover { background: var(--card-3); border-color: rgba(245,196,81,0.4); color: var(--gold); transform: translateY(-1px); }
.icon-btn .dot { position: absolute; top: 6px; right: 6px; width: 8px; height: 8px; background: var(--crimson); border-radius: 50%; border: 2px solid var(--bg); display: none; }
.icon-btn .dot.show { display: block; animation: dotPulse 1s infinite; }
@keyframes dotPulse { 0%,100% { opacity: 1; } 50% { opacity: 0.5; } }

.main { display: grid; grid-template-columns: 270px 1fr 310px; gap: 10px; min-height: 0; }
.panel { background: linear-gradient(180deg, rgba(17,23,41,0.85), rgba(17,23,41,0.6)); border: 1px solid var(--border); border-radius: 16px; backdrop-filter: blur(20px); display: flex; flex-direction: column; min-height: 0; overflow: hidden; }

.clicker-section { padding: 18px 16px 14px; display: flex; flex-direction: column; align-items: center; gap: 10px; border-bottom: 1px solid var(--border); }
.click-btn { width: 140px; height: 140px; border-radius: 50%; border: none; cursor: pointer; position: relative; background: radial-gradient(circle at 35% 30%, var(--gold-3), var(--gold) 45%, var(--gold-2)); color: #1a1408; font-family: 'Outfit', sans-serif; font-weight: 900; font-size: 16px; letter-spacing: 0.03em; box-shadow: 0 0 0 5px rgba(245,196,81,0.08), 0 0 0 10px rgba(245,196,81,0.04), 0 18px 45px rgba(245,196,81,0.25), inset 0 -8px 25px rgba(217,154,43,0.4), inset 0 3px 10px rgba(255,255,255,0.3); transition: transform .07s; display: grid; place-items: center; text-align: center; }
.click-btn::before { content: ''; position: absolute; inset: -18px; border-radius: 50%; background: radial-gradient(circle, rgba(245,196,81,0.25), transparent 65%); z-index: -1; animation: pulse 2.5s ease-in-out infinite; }
.click-btn::after { content: ''; position: absolute; inset: 0; border-radius: 50%; background: radial-gradient(circle at 35% 30%, rgba(255,255,255,0.4), transparent 50%); pointer-events: none; }
@keyframes pulse { 0%, 100% { transform: scale(1); opacity: 0.4; } 50% { transform: scale(1.2); opacity: 0.7; } }
.click-btn:active { transform: scale(0.92); }
.click-btn .amount { font-size: 26px; display: block; line-height: 1; }
.click-btn .label { font-size: 8px; font-weight: 800; letter-spacing: 0.25em; margin-top: 5px; opacity: 0.7; }
.click-info { text-align: center; font-size: 11px; color: var(--muted); } .click-info b { color: var(--gold); font-family: 'Outfit'; font-weight: 700; }
.upgrade-btn { width: 100%; background: var(--card-2); border: 1px solid var(--border); border-radius: 10px; padding: 8px 11px; cursor: pointer; display: flex; justify-content: space-between; align-items: center; transition: all .2s; color: var(--fg); font-family: inherit; }
.upgrade-btn:hover:not(:disabled) { border-color: rgba(56,189,248,0.4); background: var(--card-3); transform: translateY(-1px); }
.upgrade-btn:disabled { opacity: 0.45; cursor: not-allowed; }
.upgrade-btn .uc-label { font-size: 11px; font-weight: 600; } .upgrade-btn .uc-label small { display: block; color: var(--muted); font-size: 9px; font-weight: 400; margin-top: 2px; }
.upgrade-btn .uc-cost { font-family: 'Outfit'; font-weight: 800; font-size: 12px; color: var(--gold); white-space: nowrap; } .upgrade-btn .uc-cost::before { content: '$'; opacity: 0.6; font-size: 10px; }
.upgrade-btn.auto { border-color: rgba(16,217,129,0.2); } .upgrade-btn.auto .uc-cost { color: var(--emerald); } .upgrade-btn.auto:hover:not(:disabled) { border-color: rgba(16,217,129,0.4); }

.qstats { padding: 8px 14px; display: flex; flex-direction: column; gap: 4px; border-bottom: 1px solid var(--border); }
.qstat { display: flex; justify-content: space-between; align-items: center; padding: 6px 10px; background: rgba(255,255,255,0.02); border-radius: 8px; font-size: 11px; }
.qstat .qlabel { color: var(--muted); display: flex; align-items: center; gap: 7px; } .qstat .qlabel i { color: var(--gold); width: 12px; font-size: 10px; text-align: center; }
.qstat .qvalue { font-family: 'Outfit'; font-weight: 700; color: var(--fg); font-variant-numeric: tabular-nums; }

.daily-bonus { padding: 10px 14px; border-bottom: 1px solid var(--border); }
.daily-bonus-btn { width: 100%; background: linear-gradient(135deg, rgba(245,196,81,0.12), rgba(245,196,81,0.04)); border: 1px solid rgba(245,196,81,0.3); border-radius: 10px; padding: 10px; cursor: pointer; display: flex; align-items: center; gap: 10px; transition: all .2s; color: var(--fg); font-family: inherit; text-align: left; }
.daily-bonus-btn:hover:not(:disabled) { border-color: var(--gold); background: linear-gradient(135deg, rgba(245,196,81,0.2), rgba(245,196,81,0.08)); transform: translateY(-1px); }
.daily-bonus-btn:disabled { opacity: 0.6; cursor: not-allowed; }
.daily-bonus-btn.ready { animation: dailyPulse 1.5s infinite; }
@keyframes dailyPulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(245,196,81,0.3); } 50% { box-shadow: 0 0 0 5px rgba(245,196,81,0); } }
.daily-icon { width: 34px; height: 34px; border-radius: 9px; background: rgba(245,196,81,0.15); display: grid; place-items: center; font-size: 14px; color: var(--gold); flex-shrink: 0; }
.daily-info { flex: 1; min-width: 0; } .daily-title { font-family: 'Outfit'; font-weight: 700; font-size: 12px; } .daily-sub { font-size: 10px; color: var(--muted); margin-top: 1px; }
.daily-reward { font-family: 'Outfit'; font-weight: 800; font-size: 13px; color: var(--gold); }

.ach-mini { padding: 10px 14px; flex: 1; overflow-y: auto; }
.ach-mini-head { font-size: 9px; text-transform: uppercase; letter-spacing: 0.2em; color: var(--muted); margin-bottom: 7px; font-weight: 700; display: flex; justify-content: space-between; }
.ach-mini-head span { color: var(--gold); }
.ach-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 4px; }
.ach-cell { aspect-ratio: 1; background: rgba(255,255,255,0.03); border-radius: 7px; border: 1px solid var(--border); display: grid; place-items: center; font-size: 11px; color: rgba(255,255,255,0.15); cursor: help; transition: all .2s; }
.ach-cell.unlocked { background: rgba(245,196,81,0.12); border-color: rgba(245,196,81,0.4); color: var(--gold); }
.ach-cell:hover { transform: scale(1.15); z-index: 5; }

.land-section { display: flex; flex-direction: column; min-height: 0; }
.land-head { padding: 12px 20px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--border); }
.land-title { font-family: 'Outfit', sans-serif; font-weight: 800; font-size: 16px; letter-spacing: -0.01em; display: flex; align-items: center; gap: 9px; }
.land-title i { color: var(--gold); font-size: 14px; }
.land-info { display: flex; gap: 14px; align-items: center; font-size: 11px; color: var(--muted); }
.land-info b { color: var(--fg); font-family: 'Outfit'; font-weight: 700; font-variant-numeric: tabular-nums; }
.land-info .sep { color: rgba(255,255,255,0.1); }
.land-grid-wrap { flex: 1; display: grid; place-items: center; padding: 16px; overflow: auto; position: relative; }
.land-grid { display: grid; gap: 7px; padding: 14px; background: repeating-linear-gradient(45deg, rgba(255,255,255,0.012) 0 10px, transparent 10px 20px), rgba(0,0,0,0.15); border-radius: 14px; border: 1px solid var(--border); position: relative; }
.grid-cell { width: 80px; height: 80px; border-radius: 11px; background: rgba(255,255,255,0.02); border: 1px dashed rgba(255,255,255,0.08); cursor: pointer; position: relative; transition: all .15s; display: grid; place-items: center; }
.grid-cell:hover { background: rgba(255,255,255,0.04); border-color: rgba(245,196,81,0.25); }
.grid-cell.placeable { background: rgba(245,196,81,0.08); border: 1px dashed var(--gold); animation: shimmer 1.5s ease-in-out infinite; }
@keyframes shimmer { 0%, 100% { box-shadow: 0 0 0 0 rgba(245,196,81,0.2); } 50% { box-shadow: 0 0 0 4px rgba(245,196,81,0.08); } }
.grid-cell.has-building { background: var(--card-2); border: 1px solid var(--border); }
.grid-cell.has-building:hover { transform: translateY(-2px); filter: brightness(1.15); border-color: rgba(255,255,255,0.2); }
.building { width: 100%; height: 100%; border-radius: 10px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; position: relative; overflow: hidden; padding: 4px; --rc: var(--r-common); --rbg: rgba(156,163,175,0.1); }
.building::before { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, var(--rc), transparent 60%); opacity: 0.15; }
.building::after { content: ''; position: absolute; inset: 0; border-radius: 10px; box-shadow: inset 0 0 0 1px var(--rc); pointer-events: none; }
.building.rarity-legendary::after, .building.rarity-mythic::after, .building.rarity-cosmic::after { animation: legGlow 2s ease-in-out infinite; }
.building.rarity-epic::after { animation: epicGlow 2.5s ease-in-out infinite; }
@keyframes legGlow { 0%, 100% { box-shadow: inset 0 0 0 1px var(--rc), 0 0 15px -4px var(--rc); } 50% { box-shadow: inset 0 0 0 1px var(--rc), 0 0 30px 2px var(--rc); } }
@keyframes epicGlow { 0%, 100% { box-shadow: inset 0 0 0 1px var(--rc), 0 0 12px -4px var(--rc); } 50% { box-shadow: inset 0 0 0 1px var(--rc), 0 0 24px -1px var(--rc); } }
.building-icon { font-size: 20px; color: var(--rc); filter: drop-shadow(0 2px 5px rgba(0,0,0,0.5)); z-index: 1; line-height: 1; }
.building-name { font-size: 7.5px; text-transform: uppercase; letter-spacing: 0.03em; text-align: center; font-weight: 700; z-index: 1; color: var(--fg-2); line-height: 1.1; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding: 0 2px; }
.building-income { font-size: 9px; font-weight: 700; font-family: 'Outfit', sans-serif; color: var(--emerald); z-index: 1; line-height: 1; } .building-income::before { content: '+'; }
.building-level { position: absolute; top: 3px; right: 3px; background: var(--gold); color: #1a1408; font-family: 'Outfit'; font-weight: 900; font-size: 8px; padding: 1px 4px; border-radius: 4px; z-index: 2; line-height: 1; }
.placing-banner { position: absolute; top: 12px; left: 50%; transform: translateX(-50%); background: rgba(245,196,81,0.12); border: 1px solid var(--gold); color: var(--gold); padding: 7px 14px; border-radius: 20px; font-size: 11px; font-weight: 600; display: none; align-items: center; gap: 8px; z-index: 10; backdrop-filter: blur(10px); }
.placing-banner.show { display: flex; } .placing-banner button { background: transparent; border: none; color: var(--gold); cursor: pointer; font-size: 13px; }
.expand-bar { padding: 10px 20px; border-top: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; gap: 12px; }
.expand-info { font-size: 11px; color: var(--muted); line-height: 1.4; } .expand-info b { color: var(--fg); font-family: 'Outfit'; font-weight: 700; } .expand-info .cost { color: var(--gold); }

.btn { background: linear-gradient(135deg, var(--gold), var(--gold-2)); color: #1a1408; border: none; padding: 8px 15px; border-radius: 10px; font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 12px; cursor: pointer; transition: all .2s; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 4px 15px rgba(245,196,81,0.2); white-space: nowrap; }
.btn:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(245,196,81,0.35); filter: brightness(1.05); }
.btn:disabled { background: var(--card-2); color: var(--muted); cursor: not-allowed; box-shadow: none; opacity: 0.5; }
.btn-ghost { background: var(--card-2); color: var(--fg); border: 1px solid var(--border); box-shadow: none; }
.btn-ghost:hover:not(:disabled) { border-color: rgba(245,196,81,0.4); color: var(--gold); background: var(--card-3); }
.btn-blue { background: linear-gradient(135deg, var(--azure), #0ea5e9); color: #001520; box-shadow: 0 4px 15px rgba(56,189,248,0.2); }
.btn-blue:hover:not(:disabled) { box-shadow: 0 6px 20px rgba(56,189,248,0.35); filter: brightness(1.05); }
.btn-sm { padding: 6px 11px; font-size: 11px; border-radius: 8px; }

.tabs { display: flex; padding: 8px 10px 0; gap: 2px; border-bottom: 1px solid var(--border); }
.tab { flex: 1; background: transparent; border: none; color: var(--muted); padding: 9px 10px; cursor: pointer; font-family: 'Outfit', sans-serif; font-weight: 600; font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; border-bottom: 2px solid transparent; transition: all .2s; display: flex; align-items: center; justify-content: center; gap: 5px; margin-bottom: -1px; }
.tab.active { color: var(--gold); border-bottom-color: var(--gold); }
.tab .badge { background: var(--crimson); color: white; border-radius: 10px; padding: 1px 6px; font-size: 9px; min-width: 15px; text-align: center; font-weight: 700; letter-spacing: 0; }
.panel-body { flex: 1; overflow-y: auto; padding: 10px; }

.crate-list { display: flex; flex-direction: column; gap: 7px; }
.crate { background: linear-gradient(135deg, var(--card-2), var(--card)); border: 1px solid var(--border); border-radius: 13px; padding: 11px; cursor: pointer; transition: all .2s; position: relative; overflow: hidden; display: flex; align-items: center; gap: 11px; --cc: var(--gold); }
.crate::before { content: ''; position: absolute; inset: 0; background: linear-gradient(135deg, var(--cc), transparent 50%); opacity: 0.06; pointer-events: none; }
.crate::after { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--cc); }
.crate:hover:not(.disabled) { border-color: var(--cc); transform: translateY(-2px); box-shadow: 0 8px 25px -10px var(--cc); }
.crate:hover:not(.disabled)::before { opacity: 0.12; }
.crate.disabled { opacity: 0.45; cursor: not-allowed; }
.crate-icon { width: 48px; height: 48px; border-radius: 11px; background: linear-gradient(135deg, var(--cc), transparent); display: grid; place-items: center; font-size: 18px; color: var(--cc); filter: drop-shadow(0 0 8px var(--cc)); flex-shrink: 0; }
.crate-info { flex: 1; min-width: 0; }
.crate-name { font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 13px; margin-bottom: 3px; }
.crate-odds { font-size: 9px; color: var(--muted); display: flex; gap: 5px; flex-wrap: wrap; }
.crate-odds span { display: inline-flex; align-items: center; gap: 3px; } .crate-odds .dot { width: 5px; height: 5px; border-radius: 50%; }
.crate-price { font-family: 'Outfit', sans-serif; font-weight: 800; font-size: 14px; color: var(--gold); text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; } .crate-price::before { content: '$'; opacity: 0.6; font-size: 11px; }
.crate-price.cant { color: var(--crimson); opacity: 0.7; }

.inv-list { display: flex; flex-direction: column; gap: 5px; }
.inv-empty { text-align: center; padding: 40px 20px; color: var(--muted); font-size: 12px; }
.inv-empty i { font-size: 32px; opacity: 0.3; margin-bottom: 12px; display: block; }
.inv-empty b { display: block; color: var(--fg-2); margin-bottom: 4px; font-family: 'Outfit'; font-weight: 700; font-size: 13px; }
.inv-item { display: flex; align-items: center; gap: 9px; padding: 8px 10px; background: var(--card-2); border: 1px solid var(--border); border-left: 3px solid var(--rc); border-radius: 10px; cursor: pointer; transition: all .15s; --rc: var(--r-common); --rbg: rgba(156,163,175,0.1); }
.inv-item:hover { background: var(--card-3); transform: translateX(2px); }
.inv-icon { width: 34px; height: 34px; border-radius: 8px; background: var(--rbg); display: grid; place-items: center; font-size: 13px; color: var(--rc); flex-shrink: 0; }
.inv-info { flex: 1; min-width: 0; }
.inv-name { font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.inv-meta { font-size: 9px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; margin-top: 1px; } .inv-meta .income { color: var(--emerald); font-weight: 700; }
