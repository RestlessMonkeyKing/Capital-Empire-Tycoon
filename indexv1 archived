// ===================== UTILITIES =====================
function fmt(n) {
  if (n === Infinity) return '∞'; if (n < 0) return '-' + fmt(-n);
  if (game.settings.notation === 'full') return Math.floor(n).toLocaleString('en-US');
  if (n < 1000) return n < 10 && n % 1 !== 0 ? n.toFixed(1) : Math.floor(n).toString();
  const units = ['', 'K', 'M', 'B', 'T', 'Qa', 'Qi', 'Sx', 'Sp', 'Oc', 'No', 'Dc'];
  let u = 0; while (n >= 1000 && u < units.length - 1) { n /= 1000; u++; }
  return n.toFixed(n < 10 ? 2 : n < 100 ? 1 : 0) + units[u];
}
function money(n) { return '$' + fmt(n); }
function formatTime(ms) {
  let s = Math.floor(ms / 1000);
  let h = Math.floor(s / 3600); s %= 3600;
  let m = Math.floor(s / 60); s %= 60;
  return `${h}h ${m}m ${s}s`;
}
function getIncome(g = game) {
  let total = 0;
  for (const cell of g.grid) if (cell) total += BUILDINGS[cell.id].income * cell.level;
  total *= g.prestige.multiplier;
  if (g.boost.value > 1 && Date.now() < g.boost.endTime) total *= g.boost.value;
  total *= (1 + g.discovered.length * 0.02);
  return total;
}
function getBaseIncome() {
  let total = 0;
  for (const cell of game.grid) if (cell) total += BUILDINGS[cell.id].income * cell.level;
  return total * game.prestige.multiplier * (1 + game.discovered.length * 0.02);
}
